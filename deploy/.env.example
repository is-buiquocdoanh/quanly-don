# Copy file này thành ~/apps/quanly-don/.env rồi sửa.

# Tài khoản chủ shop, chỉ dùng ở lần chạy ĐẦU TIÊN (sau đó đổi mật khẩu trong web)
ADMIN_USER=admin
ADMIN_PASSWORD=doi-mat-khau-nay

# Token Cloudflare Tunnel (Zero Trust → Networks → Tunnels → copy chuỗi sau --token)
TUNNEL_TOKEN=

# Cổng của web trên server (chỉ mở ở 127.0.0.1, dùng để kiểm tra: curl localhost:WEB_PORT).
# Mỗi app trên server một cổng riêng (atlasweb dùng 3000). Không ảnh hưởng Cloudflare Tunnel.
WEB_PORT=3010

# AI đọc đơn trong extension (không dấu, viết tắt, địa chỉ lộn xộn). Bỏ trống = tắt AI, dùng bộ lọc thường.
# Lấy khóa ở https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
# Model AI (mặc định claude-opus-5-5). Muốn rẻ hơn: claude-haiku-5-5
# AI_MODEL=claude-opus-5-5

# Website công khai: các tên miền hiện trang giới thiệu (mặc định doanhwork.com,www.doanhwork.com)
# SITE_HOSTS=doanhwork.com,www.doanhwork.com

# Messenger: 3 mã Meta nhập trên web (mục Messenger → Nhập / đổi mã Meta), không đặt ở đây — xem docs/8-messenger.md

# Số bản sao lưu hằng ngày giữ lại TRÊN SERVER (data/backups/)
KEEP_BACKUPS=30

# Sao lưu lên Google Drive bằng backup-gdrive.sh (xem docs/6-sao-luu.md)
# GDRIVE_REMOTE=gdrive:quanly-don-backup   # tên remote rclone : thư mục trên Drive
# GDRIVE_KEEP_DAYS=365                     # bản cũ hơn số ngày này bị xóa khỏi Drive

# Phiên bản đang chạy - deploy.sh tự ghi, KHÔNG sửa tay
APP_VERSION=
