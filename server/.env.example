# Copy file này thành .env rồi sửa:  cp .env.example .env

# Tài khoản chủ shop tạo ở lần chạy ĐẦU TIÊN (sau đó đổi mật khẩu trong web)
ADMIN_USER=admin
ADMIN_PASSWORD=doi-mat-khau-nay

# Token của Cloudflare Tunnel (Cloudflare Zero Trust → Networks → Tunnels → Create → copy token)
TUNNEL_TOKEN=

# Số bản sao lưu hằng ngày giữ lại
KEEP_BACKUPS=30
